# Copy to .env and start with: uvicorn api.main:app --port 8000 --env-file .env
# Every value is optional. Never commit the real .env.

TRACKER_DB=data/tracker.db
SCHEDULER_ENABLED=true
PIPELINE_INTERVAL_MINUTES=60
# When set, POST /api/pipeline/run needs a matching X-Pipeline-Token header
PIPELINE_TOKEN=
CORS_ORIGINS=http://localhost:3000
